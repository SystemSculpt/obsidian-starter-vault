filters:
  and:
    - file.inFolder("Daily")
formulas:
  day: date(file.name).format("dddd")
properties:
  file.name:
    displayName: Day
  formula.day:
    displayName: Weekday
  file.mtime:
    displayName: Last edited
views:
  - type: table
    name: Daily notes
    order:
      - file.name
      - formula.day
      - file.mtime
    columnSize:
      file.name: 160
      formula.day: 160
    sort:
      - property: file.name
        direction: DESC
