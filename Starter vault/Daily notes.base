filters:
  and:
    - file.inFolder("Daily")
formulas:
  day: date(file.name).format("dddd")
  edited: file.mtime.format("ddd MMM D, h:mm A")
properties:
  file.name:
    displayName: Day
  formula.day:
    displayName: Weekday
  formula.edited:
    displayName: Last edited
views:
  - type: table
    name: Daily notes
    order:
      - file.name
      - formula.day
      - formula.edited
    columnSize:
      file.name: 160
      formula.day: 160
    sort:
      - property: file.name
        direction: DESC
